# environment
.venv/
__pycache__/
*.pyc
.pytest_cache/

# unrelated local files not part of this project
PITCH.docx

# optillm: a separate upstream checkout vendored locally, not a fork of this
# repo. The router-device change (issue #8) lives there and is NOT tracked here.
#
# Anchored to the root deliberately: an unanchored `optillm/` matches at every
# depth, which silently swallowed this repo's own optillm plugins under
# plugins/optillm/plugins/ - files that must be committed.
/optillm/

# staged model weights - GBs, fetched with supek/stage_model.sh
models/

# results databases, and the retired per-run JSONL/CSV output from the
# pre-SQLite harness. Kept locally as reference, never committed.
*.sqlite
*.sqlite-journal
results/
eval_results/
logs/

# Aim's tracking repository - RocksDB databases, local disk only, never Lustre.
.aim/
# Finetuned router checkpoints, and JSONL tracker output (plus its replay
# receipts) from cluster runs.
checkpoints/
runs/
*.egg-info/

# Apptainer image: vLLM + optillm + the eval harness, in one .sif.
#
# Everything the platform needs at runtime lives in here rather than in a pip
# or conda tree on Lustre - thousands of small files are the filesystem's worst
# case and degrade the cluster for everyone.
#
# Build on a login node (needs internet); see ../build_image.sh.

Bootstrap: docker
From: vllm/vllm-openai:v0.11.0

%labels
    Description  vLLM + optillm inference stack for the routing research platform
    Maintainer   router-lab

%post
    set -eu

    # The base image ships vLLM and its CUDA/torch stack already. Add optillm's
    # *dependencies* on top - but deliberately NOT optillm itself.
    #
    # This project runs a locally modified optillm: its router takes a
    # configurable device (defaulting to GPU) and its responses carry
    # `optillm_router_approach`, which is how the harness learns what the
    # router picked. A released PyPI build has neither, so installing one here
    # would silently disable issue #12's entire comparison on cluster data.
    # Instead the checkout is staged on Lustre and run from there; see
    # OPTILLM_DIR in supek/config.sh.
    # --ignore-installed blinker: the base image ships blinker via distutils
    # (apt), which pip cannot safely uninstall to satisfy flask's dependency;
    # ignoring the preinstalled copy lets pip install its own without trying.
    #
    # transformers is pinned below 5: the base image already carries a regex
    # distribution outside pip's own bookkeeping (pip installs a newer one
    # without ever reporting an "Attempting uninstall", yet the old version is
    # still what import-time metadata lookups find - a shadowed install pip
    # cannot resolve by installing a fresh copy). transformers>=5 enforces
    # regex>=2025.10.22 via its own internal dependency_versions_table at
    # import time, which that shadowed old copy can never satisfy. The 4.x
    # line has no such check and still supports ModernBERT (added in 4.48),
    # which is all the router classifier needs.
    #
    # numpy is pinned to <=2.2: the base image ships numba (a vLLM dependency,
    # used by its n-gram speculative-decoding proposer) built against NumPy
    # <=2.2. scikit-learn has no numpy pin of its own, so without this it pulls
    # the latest numpy and numba refuses to import ("Numba needs NumPy 2.2 or
    # less"), which crashes vLLM's engine core at startup.
    # optillm's server module imports the Cerebras SDK unconditionally
    # (optillm/server.py: `from cerebras.cloud.sdk import Cerebras`), even
    # though this project never routes to Cerebras - so it must be installed
    # for optillm to import at all, not just to use that provider.
    # math-verify: optillm/cepo/cepo.py imports it unconditionally too, and
    # server.py imports cepo unconditionally - same failure mode as cerebras.
    pip install --no-cache-dir --ignore-installed blinker \
        "numpy<=2.2" \
        "flask" \
        "z3-solver" \
        "sympy" \
        "scikit-learn" \
        "networkx" \
        "datasets" \
        "openai" \
        "transformers>=4.48,<5" \
        "safetensors" \
        "huggingface_hub" \
        "cerebras_cloud_sdk" \
        "math-verify"

    # scikit-learn's wheel loads scipy's compiled Cython utility module; if the
    # base image already ships a scipy whose compiled .so files are not fully
    # replaced by the upgrade above, the two end up binary-incompatible
    # ("scipy._cyutility does not export expected C function"). Force a clean
    # reinstall of just this pair so no stale base-image files survive.
    pip install --no-cache-dir --force-reinstall --no-deps scipy scikit-learn

    # Neither optillm nor the harness is baked in: both are bind-mounted from
    # Lustre at run time, so editing a grading rule or an approach does not
    # mean rebuilding a multi-GB image.

%environment
    export PYTHONUNBUFFERED=1
    # Kept off by default: it writes per-process files, and Lustre does not
    # need more small-file churn.
    export HF_HUB_DISABLE_TELEMETRY=1

%runscript
    exec "$@"

%test
    # Runs at the end of `apptainer build`, and again on demand via
    # `apptainer test --nv router-lab.sif`. On a GPU node the CUDA check is the
    # meaningful one; on a CPU-only login node it reports and moves on.
    set -eu
    # The base image only ships python3, not a `python` symlink.
    python3 -c "import vllm; print('vllm', vllm.__version__)"
    # optillm is not in the image by design - only its dependencies are, and
    # these are the ones its approaches actually fail on when missing.
    python3 -c "import flask, z3, sympy, sklearn, networkx; print('optillm deps ok')"
    # optillm/server.py imports this unconditionally even though this project
    # never routes to Cerebras - it must be installed just for optillm to
    # start.
    python3 -c "from cerebras.cloud.sdk import Cerebras; print('cerebras sdk ok')"
    python3 -c "import math_verify; print('math_verify ok')"
    python3 -c "import transformers, safetensors; print('router classifier deps ok')"
    # numba backs vLLM's n-gram speculative-decoding proposer and is strict
    # about its numpy pin - see the numpy<=2.2 note in %post.
    python3 -c "import numba, numpy; print('numba ok, numpy', numpy.__version__)"
    python3 -c "
import torch
print('torch', torch.__version__)
print('cuda available:', torch.cuda.is_available())
if torch.cuda.is_available():
    print('gpu:', torch.cuda.get_device_name(0))
else:
    print('no GPU visible here - re-run this on a GPU node with --nv')
"
